<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <title>節拍器 (修復版)</title>
    <style>
        body { font-family: sans-serif; display: flex; flex-direction: column; align-items: center; padding: 20px; }
        .controls { margin: 20px; padding: 20px; border: 1px solid #ccc; border-radius: 8px; }
        #display { display: flex; gap: 20px; margin: 30px; }
        .num { font-size: 60px; font-weight: bold; color: #ccc; transition: color 0.05s; }
        .num.active { color: #ff4757; text-shadow: 0 0 20px #ff4757; }
        #info { font-size: 20px; margin-top: 10px; }
        #preview { margin-top: 20px; padding: 10px; border-top: 1px dashed #999; color: #666; font-size: 18px; }
    </style>
</head>
<body>

    <h1>節拍器 (11次循環)</h1>
    <div class="controls">
        <label>BPM: <input type="number" id="bpm" value="120" min="40" max="240"></label>
        <button id="startBtn">開始播放</button>
    </div>

    <div id="display">
        <div class="num" id="n0">1</div>
        <div class="num" id="n1">2</div>
        <div class="num" id="n2">3</div>
        <div class="num" id="n3">4</div>
    </div>
    <div id="info">準備就緒</div>
    <div id="preview"></div>

    <script>
        const bpmInput = document.getElementById('bpm');
        const startBtn = document.getElementById('startBtn');
        const info = document.getElementById('info');
        const preview = document.getElementById('preview');
        const numElements = [document.getElementById('n0'), document.getElementById('n1'), document.getElementById('n2'), document.getElementById('n3')];
        
        let audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        let isPlaying = false;
        let combIdx = 0, noteIdx = 0, cycleCount = 0;
        let nextNoteTime = 0;

        function getPermutations(arr) {
            let results = [];
            const permute = (m, memo = []) => {
                if (m.length === 0) results.push(memo);
                else {
                    for (let i = 0; i < m.length; i++) {
                        let curr = m.slice();
                        let next = curr.splice(i, 1);
                        permute(curr.slice(), memo.concat(next));
                    }
                }
            };
            permute(arr);
            return results;
        }

        const combinations = getPermutations([1, 2, 3, 4]);

        function playTone(freq, time) {
            let osc = audioCtx.createOscillator();
            let env = audioCtx.createGain();
            osc.frequency.value = freq;
            osc.type = 'square';
            env.gain.value = 0.1;
            osc.connect(env);
            env.connect(audioCtx.destination);
            osc.start(time);
            env.gain.exponentialRampToValueAtTime(0.001, time + 0.05);
            osc.stop(time + 0.05);
        }

        function scheduler() {
            if (!isPlaying) return;
            
            // 關鍵：將預測視窗放寬，確保第一次呼叫就能觸發第一拍
            while (nextNoteTime < audioCtx.currentTime + 0.2) {
                let currentComb = combinations[combIdx];
                
                // 更新顯示
                numElements.forEach((el, i) => {
                    el.innerText = currentComb[i];
                    el.className = (i === noteIdx) ? 'num active' : 'num';
                });
                info.innerText = `目前組合: ${currentComb.join('')} | 循環: ${cycleCount + 1}/11`;
                preview.innerText = (cycleCount >= 8) ? `準備下一個: ${combinations[(combIdx + 1) % combinations.length].join('')}` : "";

                playTone(noteIdx === 0 ? 880 : 440, nextNoteTime);

                noteIdx++;
                if (noteIdx >= 4) {
                    noteIdx = 0;
                    cycleCount++;
                    if (cycleCount >= 11) {
                        cycleCount = 0;
                        combIdx = (combIdx + 1) % combinations.length;
                    }
                }
                
                nextNoteTime += 60.0 / parseFloat(bpmInput.value);
            }
            requestAnimationFrame(scheduler);
        }

